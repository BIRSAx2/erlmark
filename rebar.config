{erl_opts, [debug_info, inline, {inline_size, 100}]}.
{deps, []}.

{profiles, [
    {test, [{erl_opts, [warnings_as_errors]}]}
]}.

{dialyzer, [{warnings, [unknown]}]}.

{project_plugins, [erlfmt, rebar3_hex, rebar3_ex_doc]}.

{erlfmt, [
    write,
    {files, ["src/*.erl", "include/*.hrl", "test/*.erl"]},
    {exclude_files, ["src/erlmark_entities.erl"]}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"CHANGELOG.md", #{title => "Changelog"}},
        {"LICENSE", #{title => "License"}}
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/BIRSAx2/erlmark"}
]}.
